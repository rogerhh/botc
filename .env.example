# Cloudflare R2 credentials for the private token bucket.
#
# Copy this file to `.env` and fill in your own values. `.env` is
# gitignored, so secrets stay on your machine.
#
# How to get these:
#   1. Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API Token
#   2. Permission: "Object Read" (server only needs to download)
#   3. Specify bucket: scope to your tokens bucket only
#   4. Copy the three values it shows you (Access Key ID, Secret Access
#      Key, and the S3 endpoint URL containing your account ID)
#
# If these are unset or empty, the server still runs — it just won't
# be able to fetch missing token PNGs from R2. Anything already on
# disk under assets/tokens/ continues to work.

R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_BUCKET=botc-tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
